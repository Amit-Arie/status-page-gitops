# Terraform state — contains resource IDs, sometimes sensitive values.
# NEVER commit this, even to a private repo.
*.tfstate
*.tfstate.*
*.tfstate.backup
 
# Local Terraform working directory — downloaded provider plugins, cache.
# Large, machine-specific, and regenerated by `terraform init` — no reason
# to commit it.
.terraform/
.terraform.lock.hcl
 
# Your real values — whitelisted IPs, key pair name, domain name.
# Commit terraform.tfvars.example instead (a template with no real values).
terraform.tfvars
 
# Any SSH private keys, if they ever end up in this folder by accident.
*.pem
*.key
 
# Crash logs Terraform sometimes writes on unexpected errors — can contain
# sensitive values from your state/config.
crash.log
crash.*.log
 
# OS/editor noise
.DS_Store
*.swp
